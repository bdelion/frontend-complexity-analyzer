                "algorithmVersion": { "type": "string" },
                "unit": { "type": "string", "enum": ["count", "lines", "ratio", "depth"] },
                "subjectId": { "type": "string" },
                "scope": { "type": "string", "enum": ["own", "shared", "exposure"] },
                "observation": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "status": { "type": "string", "const": "measured" },
                        "value": { "type": "number", "minimum": 0 }
                      },
                      "required": ["status", "value"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": { "type": "string", "const": "estimated" },
                        "value": { "type": "number", "minimum": 0 },
                        "rationale": { "type": "string" }
                      },
                      "required": ["status", "value", "rationale"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": { "type": "string", "const": "unavailable" },
                        "value": { "type": "null" },
                        "reason": { "type": "string" }
                      },
                      "required": ["status", "value", "reason"],
                      "additionalProperties": false
                    }
                  ]
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "libraryId": { "type": "string" },
                      "relativePath": { "type": "string" },
                      "startLine": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                      "endLine": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                      "kind": {
                        "type": "string",
                        "enum": ["ast", "syntax", "inventory", "imported-report"]
                      }
                    },
                    "required": ["libraryId", "relativePath", "startLine", "endLine", "kind"],
                    "additionalProperties": false
                  }
                },
                "diagnosticIds": { "type": "array", "items": { "type": "string" } }
              },
              "required": [
                "id",
                "algorithmVersion",
                "unit",
                "subjectId",
                "scope",
                "observation",
                "evidence",
                "diagnosticIds"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "root", "metrics"],
        "additionalProperties": false
      }
    },
