{
  "name": "frontend-complexity-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "Analyse statique locale des composants React/TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "analyzer": "dist/cli.js",
    "rcca": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "npm run build && vitest run",
    "test:coverage": "npm run build && vitest run --coverage",
    "docs": "typedoc",
    "analyze": "node dist/cli.js analyze",
    "benchmark": "node scripts/benchmark.mjs",
    "schemas": "npm run build && node scripts/generate-schemas.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "commander": "^14.0.0",
    "picomatch": "^4.0.3",
    "ts-morph": "^27.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.0",
    "@types/picomatch": "^4.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "prettier": "^3.9.10",
    "typedoc": "^0.28.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.5"
  }
}
